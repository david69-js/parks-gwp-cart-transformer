{
  "payload": {
    "export": "cart-transform-run",
    "target": "cart.transform.run",
    "input": {
      "localization": {
        "country": {
          "isoCode": "US"
        }
      },
      "cart": {
        "buyerIdentity": {
          "isAuthenticated": true
        },
        "lines": [
          {
            "id": "gid://shopify/CartLine/1",
            "quantity": 2,
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/999"
            },
            "giftMarker": {
              "value": "true"
            }
          },
          {
            "id": "gid://shopify/CartLine/2",
            "quantity": 1,
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/999"
            },
            "giftMarker": {
              "value": "true"
            }
          }
        ]
      },
      "shop": {
        "metafield": {
          "jsonValue": {
            "min_subtotal": 100.0,
            "gift_variant_id": "gid://shopify/ProductVariant/999"
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "linesMerge": {
            "parentVariantId": "gid://shopify/ProductVariant/999",
            "cartLines": [
              {
                "cartLineId": "gid://shopify/CartLine/1",
                "quantity": 2
              },
              {
                "cartLineId": "gid://shopify/CartLine/2",
                "quantity": 1
              }
            ],
            "price": {
              "percentageDecrease": {
                "value": "100.0"
              }
            },
            "attributes": [
              {
                "key": "_gwp_gift",
                "value": "true"
              },
              {
                "key": "Gift",
                "value": "Free Gift With Purchase"
              }
            ]
          }
        }
      ]
    }
  }
}
