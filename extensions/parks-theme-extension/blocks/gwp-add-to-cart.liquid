{% comment %}
  App embed: reads the shop's $app:gwp/config metafield (set from the app's
  admin action) and, if configured, loads the script that auto-adds/removes
  the free gift line as the cart subtotal crosses the threshold.
  Requires the metafield definition to have storefront read access - the
  admin extension creates that definition the first time it saves a config.
{% endcomment %}
{% assign gwp_config = shop.metafields['$app:gwp']['config'] %}
{% if gwp_config.value.gift_variant_id %}
  <script type="application/json" id="gwp-config">
    {
      "status": {{ gwp_config.value.status | default: 'active' | json }},
      "min_subtotal": {{ gwp_config.value.min_subtotal | json }},
      "gift_variant_id": {{ gwp_config.value.gift_variant_id | json }},
      "country": {{ localization.country.iso_code | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "test_mode": {{ gwp_config.value.test_mode | json }},
      "test_tag": {{ gwp_config.value.test_tag | json }},
      "customer_tags": {% if customer %}{{ customer.tags | json }}{% else %}[]{% endif %}
    }
  </script>
  <script src="{{ 'gwp-add-to-cart.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Gift With Purchase",
  "target": "body",
  "settings": []
}
{% endschema %}
